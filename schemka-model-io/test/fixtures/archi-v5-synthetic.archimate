<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" id="model" name="Synthetic" version="5.0.0">
 <folder id="business" name="Equal" type="business"><element xsi:type="archimate:BusinessActor" id="actor" name="Actor"><property key="dup" value="1"/><property key="dup" value="2"/></element><element xsi:type="archimate:BusinessRole" id="role" name="Role"/></folder>
 <folder id="relations" name="Equal" type="relations"><element xsi:type="archimate:AssociationRelationship" id="relation" source="actor" target="role"/></folder>
 <folder id="views" name="Views" type="diagrams"><element xsi:type="archimate:ArchimateDiagramModel" id="view" name="Nested"><child xsi:type="archimate:Group" id="group" name="Group"><bounds x="100" y="100" width="400" height="300"/><child xsi:type="archimate:DiagramObject" id="a" archimateElement="actor"><bounds x="20" y="30" width="100" height="50"/><sourceConnection xsi:type="archimate:Connection" id="line" source="a" target="r" archimateRelationship="relation"><bendpoint startX="50" startY="40" endX="20" endY="10"/></sourceConnection></child><child xsi:type="archimate:DiagramObject" id="r" archimateElement="role"><bounds x="200" y="30" width="100" height="50"/></child></child></element><element xsi:type="archimate:SketchModel" id="sketch" name="Sketch"><child xsi:type="archimate:SketchModelActor" id="sketchactor" name="Person"><bounds x="10" y="20" width="80" height="100"/></child></element></folder>
 <purpose>Purpose</purpose>
</archimate:model>
